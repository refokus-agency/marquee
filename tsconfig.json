{
    "extends": "@total-typescript/tsconfig/tsc/no-dom/library",
    "compilerOptions": {
      "outDir": "./dist",
      "rootDir": "./src",
      "rewriteRelativeImportExtensions": true,
      "skipLibCheck": true,
      "sourceMap": true
    },
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "node_modules",
      "src/**/*.spec.ts"
    ]
}